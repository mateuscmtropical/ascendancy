; Engine configuration file.

config_version=5

[application]

config/name="Ascendancy"
run/main_scene="res://features/hub/hub.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameSettings="*res://core/game_settings.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/vrm/plugin.cfg", "res://addons/Godot-MToon-Shader/plugin.cfg")

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[gui]

theme/custom_font="res://art/fonts/IMFellEnglish-Regular.ttf"

[importer_defaults]

scene={
"import_script/path": "res://features/audio/tag_ground_surfaces.gd"
}
texture={
"mipmaps/generate": true
}

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
walk={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
toggle_menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
attack_punch={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1,"pressed":true), Object(InputEventKey,"physical_keycode":70)]
}
attack_kick={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2,"pressed":true), Object(InputEventKey,"physical_keycode":71)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
summon_mount={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/screen_space_aa=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/texture_mipmap_bias=-1.0
occlusion_culling/use_occlusion_culling=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="camera"

[navigation]

3d/default_cell_height=0.1

[shader_globals]

sky_time={
"type": "float",
"value": 0.0
}
night_glow={
"type": "float",
"value": 0.0
}

sun_direction={
"type": "vec3",
"value": Vector3(-0.674, -0.703, -0.226)
}
sunlight={
"type": "float",
"value": 1.0
}
