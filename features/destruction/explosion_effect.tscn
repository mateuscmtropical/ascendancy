[sub_resource type="Shader" id="rune_shader"]
code = "shader_type spatial;
render_mode blend_add, unshaded, cull_disabled, depth_draw_never, shadows_disabled;
// Círculo de runas da carga: anéis, uma faixa de glifos sorteados por célula e um polígono
// estrelado no meio, revelados do centro para fora por progress.

uniform vec3 rune_color : source_color = vec3(1.0, 0.42, 0.1);
uniform vec3 core_color : source_color = vec3(1.0, 0.92, 0.62);
uniform float energy = 2.2;
uniform float glyph_count = 20.0;
uniform float star_sides = 3.0;
uniform float glyph_seed = 0.0;
instance uniform float progress = 1.0;
instance uniform float fade = 1.0;

float hash(float value) {
	return fract(sin(value * 127.1 + glyph_seed * 31.7) * 43758.5453);
}

float ring(float radius, float at, float width) {
	return 1.0 - smoothstep(width * 0.4, width, abs(radius - at));
}

float stroke(vec2 point, vec2 from, vec2 to, float width) {
	vec2 along = to - from;
	float share = clamp(dot(point - from, along) / dot(along, along), 0.0, 1.0);
	return 1.0 - smoothstep(width * 0.5, width, length(point - from - along * share));
}

float glyph(vec2 cell, float id) {
	float pick = hash(id);
	float width = 0.12;
	float ink = stroke(cell, vec2(0.5, 0.12), vec2(0.5, 0.88), width);

	ink = max(ink, step(0.5, fract(pick * 2.0)) * stroke(cell, vec2(0.5, 0.88), vec2(0.82, 0.6), width));
	ink = max(ink, step(0.5, fract(pick * 4.0)) * stroke(cell, vec2(0.5, 0.5), vec2(0.18, 0.74), width));
	ink = max(ink, step(0.5, fract(pick * 8.0)) * stroke(cell, vec2(0.5, 0.36), vec2(0.82, 0.12), width));
	ink = max(ink, step(0.5, fract(pick * 16.0)) * stroke(cell, vec2(0.18, 0.3), vec2(0.5, 0.12), width));
	return ink;
}

float polygon(vec2 point, float turn, float inner_radius, float width) {
	float sector = TAU / star_sides;
	float angle = atan(point.y, point.x) + turn;
	float to_side = cos(floor(0.5 + angle / sector) * sector - angle) * length(point);
	return ring(to_side, inner_radius, width);
}

void fragment() {
	vec2 point = (UV - 0.5) * 2.0;
	float radius = length(point);
	float around = (atan(point.y, point.x) / TAU + 0.5) * glyph_count;
	float band = step(0.75, radius) * step(radius, 0.87);
	float ink = ring(radius, 0.96, 0.022) + ring(radius, 0.9, 0.012) + ring(radius, 0.72, 0.014);
	float inside = step(radius, 0.72);
	float reveal = smoothstep(radius - 0.2, radius, progress * 1.25);

	ink += band * glyph(vec2(fract(around), (radius - 0.75) / 0.12), floor(around));
	ink += inside * (polygon(point, 0.0, 0.36, 0.014) + polygon(point, PI / star_sides, 0.36, 0.014));
	ink += ring(radius, 0.3, 0.012) + ring(radius, 0.08, 0.025);
	ink = clamp(ink, 0.0, 1.0);
	ALBEDO = mix(rune_color, core_color, ink * 0.25) * energy * (0.6 + 0.4 * progress);
	ALPHA = ink * reveal * fade * step(radius, 1.0);
}
"

[sub_resource type="Shader" id="flash_shader"]
code = "shader_type spatial;
render_mode blend_mix, unshaded, cull_disabled, depth_draw_never, depth_test_disabled, shadows_disabled;
// Clarão da explosão: disco branco virado para a câmera com raios, por cima de tudo.

uniform float ray_count = 7.0;
instance uniform float strength = 0.0;

void vertex() {
	mat4 facing_camera = mat4(
			normalize(INV_VIEW_MATRIX[0]) * length(MODEL_MATRIX[0]),
			normalize(INV_VIEW_MATRIX[1]) * length(MODEL_MATRIX[1]),
			normalize(INV_VIEW_MATRIX[2]) * length(MODEL_MATRIX[2]),
			MODEL_MATRIX[3]);

	MODELVIEW_MATRIX = VIEW_MATRIX * facing_camera;
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
}

void fragment() {
	vec2 point = (UV - 0.5) * 2.0;
	float radius = length(point);
	float angle = atan(point.y, point.x);
	float core = 1.0 - smoothstep(0.0, 0.6, radius);
	float rays = abs(sin(angle * ray_count + 1.0) * sin(angle * (ray_count * 2.0 - 1.0) + 2.3));

	rays = smoothstep(0.2, 0.75, rays) * (1.0 - smoothstep(0.15, 1.0, radius));
	ALBEDO = vec3(1.0, 0.98, 0.92) * 1.6;
	ALPHA = clamp(core * 1.6 + rays * 0.9, 0.0, 1.0) * strength;
}
"

[sub_resource type="Shader" id="fireball_shader"]
code = "shader_type spatial;
render_mode unshaded, cull_back, shadows_disabled;
// Bola de fogo: esfera encaroçada por ruído, cor em faixas pela rampa de calor; life (0 a 1)
// esfria as faixas, rói a casca e escurece o que sobra em fumaça.

uniform sampler2D noise_texture : repeat_enable, filter_linear_mipmap;
uniform sampler2D heat_ramp : repeat_disable, source_color;
uniform vec3 smoke_color : source_color = vec3(0.1, 0.085, 0.09);
uniform float energy = 1.25;
uniform float bands = 5.0;
instance uniform float life = 0.0;

void vertex() {
	float lump = textureLod(noise_texture, UV * vec2(2.0, 1.0) + vec2(0.0, -TIME * 0.12), 0.0).r;

	VERTEX += NORMAL * (lump - 0.5) * 0.3;
}

void fragment() {
	vec2 noise_uv = UV * vec2(3.0, 1.5) + vec2(TIME * 0.04, -TIME * 0.25);
	float coarse = texture(noise_texture, noise_uv).r;
	float fine = texture(noise_texture, noise_uv * 2.7 + vec2(0.3, -TIME * 0.2)).r;
	float facing = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
	float heat = clamp(coarse * 0.8 + fine * 0.3 + facing * 0.45 - life * 1.15, 0.0, 1.0);
	vec3 fire = texture(heat_ramp, vec2(floor(heat * bands) / bands + 0.5 / bands, 0.5)).rgb * energy;

	if (coarse * 0.7 + fine * 0.3 + facing * 0.2 < smoothstep(0.3, 1.0, life) * 1.25) {
		discard;
	}

	ALBEDO = mix(fire, smoke_color, smoothstep(0.45, 0.95, life) * (1.0 - heat));
}
"

[sub_resource type="Shader" id="shockwave_shader"]
code = "shader_type spatial;
render_mode blend_add, unshaded, cull_disabled, depth_draw_never, shadows_disabled;
// Onda de choque rente ao chão: anel fino com rastro para dentro.

uniform vec3 wave_color : source_color = vec3(1.0, 0.85, 0.6);
uniform float energy = 2.5;
instance uniform float fade = 0.0;

void fragment() {
	float radius = length((UV - 0.5) * 2.0);
	float front = 1.0 - smoothstep(0.0, 0.05, abs(radius - 0.93));
	float trail = smoothstep(0.55, 0.93, radius) * step(radius, 0.93) * 0.35;

	ALBEDO = wave_color * energy;
	ALPHA = (front + trail) * fade;
}
"

